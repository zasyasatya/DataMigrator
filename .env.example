# ---------------------------------------------------------------- Sapa AI env
# Salin ke .env (dibaca oleh backend FastAPI; frontend pakai default proxy).

# --- database (default SQLite zero-config; ganti untuk Postgres produksi) ---
DATABASE_URL=sqlite+aiosqlite:///./data/sapa.db
# DATABASE_URL=postgresql+asyncpg://sapa:sapa@localhost:5432/sapa

# --- keamanan ---------------------------------------------------------------
SECRET_KEY=ganti-dengan-string-acak-panjang
ADMIN_EMAIL=admin@sapa.ai
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Sapa
WORKSPACE_NAME=Acme Store

# --- LLM provider (OpenAI-compatible: OpenAI / Groq / OpenRouter / Ollama) ---
# Kosongkan OPENAI_API_KEY untuk menjalankan engine offline (retrieval + rules).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- urls --------------------------------------------------------------------
APP_URL=http://localhost:3000
# CORS_origins dipisah koma; "*" = semua (widget tetap dibatasi allowed_origins per agent)
CORS_ORIGINS=["*"]

# --- seeding ------------------------------------------------------------------
# SEED_DEMO=1 mengisi contoh percakapan agar dashboard tidak kosong (default: development)
SEED_DEMO=1
