# ---------------------------------------------------------------- Sapa AI env
# Salin ke .env (dibaca oleh backend FastAPI; frontend pakai default proxy).

# --- database (default SQLite zero-config; ganti untuk Postgres produksi) ---
DATABASE_URL=sqlite+aiosqlite:///./data/sapa.db
# DATABASE_URL=postgresql+asyncpg://sapa:sapa@localhost:5432/sapa

# --- keamanan ---------------------------------------------------------------
SECRET_KEY=ganti-dengan-string-acak-panjang
ADMIN_EMAIL=admin@sapa.ai
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Sapa
WORKSPACE_NAME=Acme Store
# Admin bootstrap selalu dipastikan ada setiap boot (lihat app/seed.py).
# Set 1 SEKALI untuk memaksa password admin disamakan dengan ADMIN_PASSWORD
# (gunanya saat lupa password di produksi), lalu kembalikan ke 0.
RESET_ADMIN_PASSWORD=0

# --- LLM provider (OpenAI-compatible: OpenAI / Groq / OpenRouter / Ollama) ---
# Kosongkan OPENAI_API_KEY untuk menjalankan engine offline (retrieval + rules).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- urls --------------------------------------------------------------------
APP_URL=http://localhost:3000
# CORS_origins dipisah koma; "*" = semua (widget tetap dibatasi allowed_origins per agent)
CORS_ORIGINS=["*"]

# --- proxy dashboard -> backend (DIBACA SAAT RUNTIME) ------------------------
# Dipakai route handler apps/web/app/{api/v1,w,embed}/[...path]/route.ts.
# Gunakan IP eksplisit, jangan `localhost`: di container `localhost` bisa
# resolve ke IPv6 ::1 sementara uvicorn hanya listen IPv4 -> ECONNREFUSED.
#   all-in-one / lokal : http://127.0.0.1:8000
#   docker compose     : http://api:8000
# API_INTERNAL_URL=http://127.0.0.1:8000

# --- seeding ------------------------------------------------------------------
# SEED_DEMO=1 mengisi contoh percakapan agar dashboard tidak kosong (default: development)
SEED_DEMO=1

# --- opsional -----------------------------------------------------------------
# LOG_LEVEL=INFO
# PORT=3000          # port dashboard (Coolify meng-inject variabel ini)
# API_PORT=8000      # port internal backend
