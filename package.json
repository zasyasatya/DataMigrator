{
  "name": "sapa-ai-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Sapa AI — no-code AI agent chatbot platform (Next.js dashboard + FastAPI engine + embeddable popup widget)",
  "workspaces": [
    "apps/web",
    "packages/widget"
  ],
  "scripts": {
    "build:widget": "npm run build --workspace @sapa/widget",
    "dev:web": "npm run dev --workspace @sapa/web",
    "build:web": "npm run build --workspace @sapa/web",
    "dev:api": "uvicorn app.main:app --app-dir apps/api --reload --host 0.0.0.0 --port 8000",
    "test:api": "pytest apps/api/tests -q"
  },
  "engines": {
    "node": ">=20"
  }
}
